# Copy to .env and replace both secret placeholders before starting.
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_DJANGO_SECRET_KEY
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection for Python on the host.
# Compose uses the internal host db and port 5432 for the web container.
DB_ENGINE=postgresql
PGDATABASE=housing_registry
PGUSER=housing_registry
PGPASSWORD=REPLACE_WITH_A_RANDOM_POSTGRES_PASSWORD
PGHOST=127.0.0.1
PGPORT=5432

# Optional PostgreSQL TLS settings; set these for a remote database.
PGSSLMODE=
PGSSLROOTCERT=
DB_CONN_MAX_AGE=60
